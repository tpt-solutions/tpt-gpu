# OS / editor
.vscode/
.DS_Store
Thumbs.db

# TPT / app artifacts (best-effort)
*.log
*.tmp
*.swp
*.swo

# Build outputs
/dist/
/build/
/out/
target/

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
package-lock.json

# Native build artifacts (e.g. crates/out-gpu-runtime-c examples)
*.exe
*.dll
*.so
*.dylib

# Local AI-tool config (not project source)
.kilo/

# Local-only cargo overrides (e.g. redirecting the pinned `tpt-uir` git deps at
# a sibling checkout — see AGENTS.md). Must never be committed: the paths only
# exist on one machine and would break CI exactly like the old path deps did.
.cargo/config.toml
.cargo/config
